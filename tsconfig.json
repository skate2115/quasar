{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "paths": {
      "@tauri-apps/api/window": ["src/tauri-mock/window.ts"],
      "@tauri-apps/api/path": ["src/tauri-mock/path.ts"],
      "@tauri-apps/api/core": ["src/tauri-mock/core.ts"],
      "@tauri-apps/api": ["src/tauri-mock/index.ts"],
      "@tauri-apps/plugin-fs": ["src/tauri-mock/fs.ts"],
      "@tauri-apps/plugin-dialog": ["src/tauri-mock/dialog.ts"],
      "@tauri-apps/plugin-shell": ["src/tauri-mock/shell.ts"],
      "@tauri-apps/plugin-opener": ["src/tauri-mock/opener.ts"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
